   "edit": "https://github.com/Stanford-SkyRunners/ridgeback-design/edit/main/data/parts.toml",
   "editLine": 20,
   "calc": [
    [
     "E_{flight} = E_{hover} + E_{climb} + P\\,(t_{survey} + t_{transit}) = 161\\ \\text{Wh}",
     "energy for one 15-minute survey, 1 km out and back"
    ],
    [
     "E_{pack,\\,needed} = \\dfrac{3 \\times 161}{0.85 \\times 0.8} = 708\\ \\text{Wh}",
     "three flights, keeping the cells between 95 % and 10 % and 20 % in reserve"
    ],
    [
     "708\\ \\text{Wh needed} \\;>\\; 648\\ \\text{Wh in 6S6P}",
